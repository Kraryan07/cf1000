#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
      long long n,p;
      cin>>n>>p;

      vector<long long>a(n),b(n);
      vector<pair<long long,long long>>v(n);

      for(int i=0;i<n;i++){
        cin>>a[i];
      }
      for(int i=0;i<n;i++){
        cin>>b[i];
      }
      for(int i=0;i<n;i++){
        v[i]={b[i],a[i]};
      }

      sort(v.begin(),v.end());
      long long mincost=p;
      long long already=1;

      for(auto x:v){
        long long cost=x.first;
        long long can_be_share=x.second;

        if(cost>=p){
            long long rem=n-already;
            mincost+=rem*p;
            break;
        }

        if(already+can_be_share>n){
            long long rem=n-already;
            mincost+=rem*cost;
            break;
        }
        mincost+=can_be_share*cost;
        already+=can_be_share;
      }

      cout<<mincost<<endl;
    }
}
