#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
       long long n;
      cin>>n;
      vector<long long>a(n),b(n);
    //   unordered_map<int,int>ma,mb;
      for(int i=0;i<n;i++){
        cin>>a[i];
      }
      for(int i=0;i<n;i++){
        cin>>b[i];
      }
      vector<long long>suba(2*n+1,0);
      vector<long long>subb(2*n+1,0);
      long long counter=1;
      for(int i=1;i<n;i++){
         if(a[i]==a[i-1]){
            counter++;
         }
         else{
            suba[a[i-1]]=max(suba[a[i-1]],counter);
            counter=1;
         }
      }
      suba[a[n-1]]=max(suba[a[n-1]],counter);
      counter=1;
      for(int i=1;i<n;i++){
         if(b[i]==b[i-1]){
            counter++;
         }
         else{
            subb[b[i-1]]=max(subb[b[i-1]],counter);
            counter=1;
         }
      }
      subb[b[n-1]]=max(subb[b[n-1]],counter);
      long long maxval=0;
      for(int i=1;i<=2*n;i++){
         maxval=max(maxval,suba[i]+subb[i]);
      }
      cout<<maxval<<endl;
    }
}
