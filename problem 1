#include<bits/stdc++.h>
using namespace std;
 
int main(){
    int t;
    cin>>t;
    while(t--){
     string s;
     cin>>s;
     int one=0,zero=0;
     for(int i=0;i<s.size();i++){
        if(s[i]=='1'){
            one++;
        }
        else{
            zero++;
        }
     }
      
     int cnt=0;
   
     for(int i=0;i<s.size();i++){
        if(s[i]=='1' && zero>0){
           zero--;
           cnt++;
        }
        else if(s[i]=='0' && one>0){
            one--;
            cnt++;
        }
        else{
            break;
        }
     }
     cout<<s.size()-cnt<<endl;
    }
}
