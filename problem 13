#include<bits/stdc++.h>
using namespace std;

int main(){
      int t;
      cin>>t;
      while(t--){
        long long n,x;
        cin>>n>>x;

        vector<long long>a(n);
        for(int i=0;i<n;i++){
         cin>>a[i];
        }
        long long cnt=0;
        long long maxval=a[0]+x;
        long long minval=a[0]-x;
        for(int i=1;i<n;i++){
          long long nextmax=a[i]+x;
          long long nextmin=a[i]-x;
          
          if(max(minval,nextmin)<=min(maxval,nextmax)){
             maxval=min(maxval,nextmax);
             minval=max(minval,nextmin);
          }
          else{
            cnt++;
            maxval=nextmax;
            minval=nextmin;
          }
        }
        cout<<cnt<<endl;
      }
}
