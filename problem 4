#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
      int n;
      cin>>n;
      vector<vector<long long>>a;
      for(int i=0;i<n;i++){
        int m;
        cin>>m;
        vector<long long>b(m);
        for(int j=0;j<m;j++){
            cin>>b[j];
        }
        sort(b.begin(),b.end());
        a.push_back(b);
      }

      long long firstmin=INT_MAX;
      long long secondmin=INT_MAX;
      long long total=0;
      for(int i=0;i<n;i++){
        firstmin=min(firstmin,a[i][0]);
        secondmin=min(secondmin,a[i][1]);
        total+=a[i][1];
      }
      total=total-secondmin+firstmin;
      cout<<total<<endl;
    }
}
