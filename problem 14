#include<bits/stdc++.h>
using namespace std;

int main(){
      int t;
      cin>>t;
      while(t--){
        long long n;
        cin>>n;
        vector<long long>s(n);
        unordered_map<long long,long long>mpp;
        for(int i=0;i<n;i++){
         cin>>s[i];
         mpp[s[i]]++;
        }
        bool ok=false;
        for(auto &it:mpp){
         if(it.second==1){
            ok=true;
            break;
          }
        }

        if(ok){
         cout<<-1<<endl;
         continue;
        }

        vector<long long>stu(n);
        for(int i=0;i<n;i++){
         stu[i]=i+1;
        }

        long long l=0,r=0;
        while(r<n){
           if(s[l]==s[r]){
             r++;
           }
           else{
             rotate(stu.begin()+l,stu.begin()+l+1,stu.begin()+r);
             l=r;
           }
        }
        rotate(stu.begin()+l,stu.begin()+l+1,stu.begin()+r);
        for(auto i:stu){
          cout<<i<<" ";
        }
        cout<<endl;
      }
}
