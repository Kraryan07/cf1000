#include<bits/stdc++.h>
using namespace std;

int main(){
      int t;
      cin>>t;
      while(t--){
         long long n,k,b,s;
         cin>>n>>k>>b>>s;
         long long mins=k*b;
         long long maxs=k*b+n*(k-1);
         if(s>maxs||s<mins){
            cout<<"-1"<<endl;
         }
         else{
            vector<long long>res(n,0);
           res[0]=mins;
           s-=mins;
           for(int i=0;i<n;i++){
            long long add=min(k-1,s);
            res[i]+=add;
            s-=add;
            if(s==0) break;
           }
           for(long long i=0;i<n;i++){
            cout<<res[i]<<" ";
           }
           cout<<endl;
         }
      }
}
